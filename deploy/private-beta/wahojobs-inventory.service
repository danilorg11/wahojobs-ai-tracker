[Unit]
Description=Wahojobs bounded daily inventory (owner activation required)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/wahojobs-inventory-v1.json

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/wahojobs-beta/current
ExecStart=/opt/wahojobs-beta/current/.venv/bin/python -B scripts/daily_inventory.py run --policy /etc/wahojobs-inventory-v1.json --trigger auto
ExecStopPost=/opt/wahojobs-beta/current/.venv/bin/python -B scripts/daily_inventory.py recover --policy /etc/wahojobs-inventory-v1.json
TimeoutStartSec=2520
TimeoutStopSec=120
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
Restart=no
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal
